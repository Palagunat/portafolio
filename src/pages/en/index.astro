---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Home from '../../components/Home.astro';
import { site } from '../../data/site';
import { ui } from '../../data/i18n';

const t = ui.en;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: t.hero.role,
  email: `mailto:${site.email}`,
  url: Astro.site?.href ? new URL('en/', Astro.site).href : undefined,
  sameAs: [site.github, site.clientSite],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ibagué',
    addressRegion: 'Tolima',
    addressCountry: 'CO',
  },
  knowsLanguage: ['es', 'en'],
  knowsAbout: [
    'Go',
    'Flutter',
    'Dart',
    'Python',
    'Django',
    'PostgreSQL',
    'Kubernetes',
    'Docker',
    'REST APIs',
    'Offline-first software',
  ],
};
---

<BaseLayout lang="en" jsonLd={jsonLd}>
  <Home lang="en" />
</BaseLayout>
