---
import ProjectCard from './ProjectCard.astro';
import { gridProjects, getShots } from '../data/projects';
import { type Lang } from '../data/site';
import { ui } from '../data/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="section" id="proyectos" data-section="proyectos">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">
        <span class="eyebrow__dot"></span>
        <span class="eyebrow__num">02</span>
        {t.projects.eyebrow}
      </p>
      <h2 class="section-head__title">{t.projects.title}</h2>
      <p class="section-head__text">{t.projects.lead}</p>
    </header>

    <div class="projects-grid">
      {
        gridProjects.map((project, index) => (
          <ProjectCard project={project} shots={getShots(project.slug)} lang={lang} index={index} />
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: clamp(1.1rem, 2.4vw, 1.75rem);
  }

  @media (min-width: 861px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1180px) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
